Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.0.1";
	Обработчик.Процедура = "ЕРП_ОбработкаОчередиУведомлений.ИнициализироватьНастройкиИРасписания";
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.ВыполнятьВМонопольномРежиме = Ложь;
	Обработчик.Обязательный = Истина;
	
КонецПроцедуры

