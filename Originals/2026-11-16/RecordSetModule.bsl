#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ДополнительныеСвойства.Свойство("ПропуститьПроверкуЦелостности") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Замещение Тогда
		Отказ = Истина;
		ВызватьИсключение "Запись в регистр ЕРП_НастройкиУведомлений разрешена только с замещением единственного профиля 'Основной'.";
	КонецЕсли;
	
	Если Количество() <> 1 Тогда
		Отказ = Истина;
		ВызватьИсключение "В регистре ЕРП_НастройкиУведомлений должна существовать ровно одна запись с профилем 'Основной'.";
	КонецЕсли;
	
	Запись = ЭтотОбъект.Получить(0);
	Если СокрЛП(Запись.ПрофильНастроек) <> "Основной" Тогда
		Отказ = Истина;
		ВызватьИсключение "Допускается только профиль настроек с ключом 'Основной'.";
	КонецЕсли;
	
	ЭлементОтбора = Отбор.ПрофильНастроек;
	Если ЭлементОтбора.Использование И СокрЛП(ЭлементОтбора.Значение) <> "Основной" Тогда
		Отказ = Истина;
		ВызватьИсключение "Отбор при записи настроек должен соответствовать профилю 'Основной'.";
	КонецЕсли;
	
	// Если запись идёт с отбором по "Основной", проверяем отсутствие посторонних записей в БД
	Если ЭлементОтбора.Использование Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.ПрофильНастроек КАК ПрофильНастроек
		|ИЗ
		|	РегистрСведений.ЕРП_НастройкиУведомлений КАК Настройки
		|ГДЕ
		|	Настройки.ПрофильНастроек <> ""Основной""";
		Если Не Запрос.Выполнить().Пустой() Тогда
			Отказ = Истина;
			ВызватьИсключение "В регистре ЕРП_НастройкиУведомлений обнаружены посторонние профили. Устраните нарушение целостности перед сохранением.";
		КонецЕсли;
	КонецЕсли;
	
	Если Запись.МаксимальноеКоличествоПопыток < 1
		Или Запись.СрокАрендыСекунд < 60
		Или Запись.БазоваяЗадержкаПовтораСекунд < 5
		Или Запись.СрокХраненияОчередиДней < 1 Тогда
		Отказ = Истина;
		ВызватьИсключение "Некорректные числовые параметры в профиле 'Основной' (попытки >= 1, аренда >= 60 сек, задержка >= 5 сек, хранение >= 1 дн).";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
