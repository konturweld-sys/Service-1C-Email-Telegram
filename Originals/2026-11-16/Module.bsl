#Область ОбработчикиСобытийФормы

&AtServer
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроверитьИИнициализироватьПрофильНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&AtClient
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	ПоказатьПредупреждение(, "Создание дополнительных профилей запрещено. В системе используется только единственный профиль 'Основной'.");
	
КонецПроцедуры

&AtClient
Процедура СписокПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	ПоказатьПредупреждение(, "Удаление единственного профиля настроек 'Основной' запрещено.");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&AtServer
Процедура ПроверитьИИнициализироватьПрофильНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Настройки.ПрофильНастроек КАК ПрофильНастроек
	|ИЗ
	|	РегистрСведений.ЕРП_НастройкиУведомлений КАК Настройки";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	// Инициализация выполняется ТОЛЬКО при полностью пустом регистре
	Если Таблица.Количество() = 0 Тогда
		НаборЗаписей = РегистрыСведений.ЕРП_НастройкиУведомлений.СоздатьНаборЗаписей();
		Запись = НаборЗаписей.Добавить();
		Запись.ПрофильНастроек = "Основной";
		Запись.ОтправкаРазрешена = Истина;
		Запись.МаксимальноеКоличествоПопыток = 3;
		Запись.СрокАрендыСекунд = 300;
		Запись.БазоваяЗадержкаПовтораСекунд = 30;
		Запись.СрокХраненияОчередиДней = 30;
		НаборЗаписей.Записать(Истина);
		Возврат;
	КонецЕсли;
	
	Если Таблица.Количество() > 1 Тогда
		Сообщить("ОШИБКА ЦЕЛОСТНОСТИ: В регистре обнаружено несколько профилей настроек. Обработка очереди заблокирована до удаления лишних записей.");
		Возврат;
	КонецЕсли;
	
	ЕдинственнаяЗапись = Таблица.Получить(0);
	Если СокрЛП(ЕдинственнаяЗапись.ПрофильНастроек) <> "Основной" Тогда
		Сообщить(СтрШаблон(
			"ОШИБКА ЦЕЛОСТНОСТИ: В регистре обнаружена запись с некорректным ключом '%1' вместо 'Основной'. Обработка очереди заблокирована.",
			ЕдинственнаяЗапись.ПрофильНастроек));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
