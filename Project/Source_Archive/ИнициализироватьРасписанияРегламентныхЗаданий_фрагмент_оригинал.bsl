// Настраивает расписание предопределённых регламентных заданий в информационной базе.
// Вызывается при начальном заполнении или обновлении расширения.
Процедура ИнициализироватьРасписанияРегламентныхЗаданий() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = РегламентныеЗадания.Выбрать();
	Пока Выборка.Следующий() Цикл
		Задание = Выборка.ПолучитьОбъект();
		ИмяМетаданных = Задание.Метаданные().Имя;
		
		Если ИмяМетаданных = "ЕРП_ОтправкаУведомленийПоОчереди" Тогда
			Расписание = Новый РасписаниеРегламентногоЗадания;
			Расписание.ПериодПовтораДней = 1;
			Расписание.ПериодПовтораВТечениеДня = 10;
			Задание.Расписание = Расписание;
			Задание.Использование = Истина;
			Задание.Записать();
			
		ИначеЕсли ИмяМетаданных = "ЕРП_ОчисткаУстаревшихУведомлений" Тогда
			Расписание = Новый РасписаниеРегламентногоЗадания;
			Расписание.ПериодПовтораДней = 1;
			Расписание.ВремяНачала = Дата(1, 1, 1, 3, 0, 0);
			Задание.Расписание = Расписание;
			Задание.Использование = Истина;
			Задание.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
