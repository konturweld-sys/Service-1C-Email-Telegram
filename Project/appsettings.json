{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        },
        "EventLog": {
            "SourceName": "OneCIntegrationService",
            "LogLevel": {
                "Default": "Information"
            }
        }
    },
    "OneCConnection": {
        "ConnectionString": "",
        "CredentialTargetName": "1C_Integration_Bot"
    },
    "MonitorSettings": {
        "MaskSyncIntervalSeconds": 60,
        "FallbackPollIntervalSeconds": 15,
        "LookbackWindowSeconds": 60,
        "MaxTailBytes": 10485760,
        "MaxLogEntryLength": 2000,
        "LogFileEncoding": "utf-8",
        "SupportedDateFormats": [
            "yyyy-MM-dd HH:mm:ss",
            "yyyy-MM-dd HH:mm:ss.fff",
            "yyyy-MM-dd'T'HH:mm:ss",
            "dd.MM.yyyy HH:mm:ss",
            "dd.MM.yyyy HH:mm:ss.fff",
            "yyyyMMddHHmmss"
        ]
    }
}