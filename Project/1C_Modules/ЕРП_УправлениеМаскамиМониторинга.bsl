#Область ПрограммныйИнтерфейс

// Возвращает массив структур с параметрами всех активных и корректно заполненных масок мониторинга.
// Используется при формировании ответа для .NET-службы.
//
// Возвращаемое значение:
//  Массив из Структура - Список активных масок с параметрами поиска.
//
Функция ПолучитьСписокАктивныхМасок() Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Маски.Ссылка КАК Ссылка,
	|	Маски.Наименование КАК Наименование,
	|	Маски.ПутьКФайлуЛога КАК ПутьКФайлуЛога,
	|	Маски.РегулярноеВыражениеВремени КАК РегулярноеВыражениеВремени,
	|	Маски.ТипПоиска КАК ТипПоиска,
	|	Маски.УсловиеПоиска КАК УсловиеПоиска,
	|	Маски.ИсключающиеСлова КАК ИсключающиеСлова,
	|	Маски.УчитыватьРегистр КАК УчитыватьРегистр,
	|	Маски.ШаблонТекстаСобытия КАК ШаблонТекстаСобытия
	|ИЗ
	|	Справочник.ЕРП_МаскиМониторингаЛогов КАК Маски
	|ГДЕ
	|	Маски.Активна = ИСТИНА
	|	И Маски.ПометкаУдаления = ЛОЖЬ
	|	И Маски.ЭтоГруппа = ЛОЖЬ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПутьКФайлу = СокрЛП(Выборка.ПутьКФайлуЛога);
		Если ПустаяСтрока(ПутьКФайлу) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТипаПоиска = ПредставлениеТипаПоиска(Выборка.ТипПоиска);
		Если ПустаяСтрока(СтрокаТипаПоиска) Тогда
			ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.УправлениеМасками",
				УровеньЖурналаРегистрации.Предупреждение, , Выборка.Ссылка,
				"Маска пропущена при выгрузке: не указан или неизвестен ТипПоиска.");
			Продолжить;
		КонецЕсли;
		
		ОписаниеМаски = Новый Структура;
		ОписаниеМаски.Вставить("maskId", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		ОписаниеМаски.Вставить("maskName", СокрЛП(Выборка.Наименование));
		ОписаниеМаски.Вставить("filePath", ПутьКФайлу);
		ОписаниеМаски.Вставить("timeRegex", СокрЛП(Выборка.РегулярноеВыражениеВремени));
		ОписаниеМаски.Вставить("searchType", СтрокаТипаПоиска);
		ОписаниеМаски.Вставить("searchPattern", Выборка.УсловиеПоиска);
		ОписаниеМаски.Вставить("excludeWords", СокрЛП(Выборка.ИсключающиеСлова));
		ОписаниеМаски.Вставить("caseSensitive", Выборка.УчитыватьРегистр);
		ОписаниеМаски.Вставить("messageTemplate", Выборка.ШаблонТекстаСобытия);
		
		Результат.Добавить(ОписаниеМаски);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет существование, активность, отсутствие пометки удаления и признака группы маски по GUID
// средствами платформы (без обращения к БСП).
//
// Параметры:
//  ИдентификаторСтрокой - Строка - GUID маски.
//
// Возвращаемое значение:
//  Структура - Поля:
//   * Найдена        - Булево
//   * МаскаСсылка    - СправочникСсылка.ЕРП_МаскиМониторингаЛогов
//   * ОписаниеОшибки - Строка
//
Функция НайтиАктивнуюМаскуПоИдентификатору(ИдентификаторСтрокой) Экспорт
	
	Результат = Новый Структура("Найдена, МаскаСсылка, ОписаниеОшибки",
		Ложь, Справочники.ЕРП_МаскиМониторингаЛогов.ПустаяСсылка(), "");
	
	ОчищенныйГУИД = СокрЛП(ИдентификаторСтрокой);
	Если ПустаяСтрока(ОчищенныйГУИД) Или СтрДлина(ОчищенныйГУИД) <> 36 Тогда
		Результат.ОписаниеОшибки = "Некорректная длина или пустое значение maskId.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		УИД = Новый УникальныйИдентификатор(ОчищенныйГУИД);
		КандидатСсылка = Справочники.ЕРП_МаскиМониторингаЛогов.ПолучитьСсылку(УИД);
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон("Некорректный формат GUID в поле maskId: %1", ОчищенныйГУИД);
		Возврат Результат;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", КандидатСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маски.Ссылка КАК Ссылка,
	|	Маски.Наименование КАК Наименование,
	|	Маски.Активна КАК Активна,
	|	Маски.ПометкаУдаления КАК ПометкаУдаления,
	|	Маски.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ЕРП_МаскиМониторингаЛогов КАК Маски
	|ГДЕ
	|	Маски.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Результат.ОписаниеОшибки = СтрШаблон("Маска с идентификатором %1 не найдена в базе 1С.", ОчищенныйГУИД);
		Возврат Результат;
	КонецЕсли;
	
	Если Выборка.ЭтоГруппа Тогда
		Результат.ОписаниеОшибки = СтрШаблон("Указанный идентификатор %1 принадлежит группе масок, а не элементу.", ОчищенныйГУИД);
		Возврат Результат;
	КонецЕсли;
	
	Если Выборка.ПометкаУдаления Или Не Выборка.Активна Тогда
		Результат.ОписаниеОшибки = СтрШаблон("Маска '%1' (%2) не активна или помечена на удаление.",
			СокрЛП(Выборка.Наименование), ОчищенныйГУИД);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Найдена = Истина;
	Результат.МаскаСсылка = Выборка.Ссылка;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеТипаПоиска(ЗначениеПеречисления)
	
	Если ЗначениеПеречисления = Перечисления.ЕРП_ТипыПоискаМаски.ПоследовательностьСлов Тогда
		Возврат "ПоследовательностьСлов";
	ИначеЕсли ЗначениеПеречисления = Перечисления.ЕРП_ТипыПоискаМаски.ВсеСловаИ Тогда
		Возврат "ВсеСловаИ";
	ИначеЕсли ЗначениеПеречисления = Перечисления.ЕРП_ТипыПоискаМаски.ЛюбоеСловоИЛИ Тогда
		Возврат "ЛюбоеСловоИЛИ";
	ИначеЕсли ЗначениеПеречисления = Перечисления.ЕРП_ТипыПоискаМаски.РегулярноеВыражение Тогда
		Возврат "РегулярноеВыражение";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

#КонецОбласти
