#Область ПрограммныйИнтерфейс

// Отправляет простое текстовое электронное письмо через штатный программный интерфейс БСП.
// Возвращает унифицированный результат, совместимый с трехфазной моделью аренды очереди.
//
// Параметры:
//  АдресEmail         - Строка - Адрес электронной почты получателя.
//  ТемаПисьма         - Строка - Тема электронного письма.
//  ТекстПисьма        - Строка - Текст уведомления.
//  УчетнаяЗаписьПочты - ОпределяемыйТип.ЕРП_УчетнаяЗаписьПочты - Учетная запись отправки (если пусто — системная).
//
// Возвращаемое значение:
//  Структура - Содержит поля:
//   * Успех          - Булево - Истина, если письмо успешно передано SMTP-серверу.
//   * ОписаниеОшибки - Строка - Описание ошибки при неудачной отправке.
//   * RetryAfter     - Число  - Рекомендованная задержка перед повтором в секундах (по умолчанию 0).
//
Функция ОтправитьПисьмо(АдресEmail, ТемаПисьма, ТекстПисьма, УчетнаяЗаписьПочты = Неопределено) Экспорт

    Результат = Новый Структура("Успех, ОписаниеОшибки, RetryAfter", Ложь, "", 0);

    Если Не ЗначениеЗаполнено(АдресEmail) Тогда
        Результат.ОписаниеОшибки = "Не указан адрес электронной почты получателя.";
        Возврат Результат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ТекстПисьма) Тогда
        Результат.ОписаниеОшибки = "Текст электронного письма не может быть пустым.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        ПараметрыПисьма = РаботаСПочтовымиСообщениями.ПараметрыОтправкиПисьма();

        Если ЗначениеЗаполнено(УчетнаяЗаписьПочты) Тогда
            ПараметрыПисьма.УчетнаяЗапись = УчетнаяЗаписьПочты;
        Иначе
            ПараметрыПисьма.УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
        КонецЕсли;

        Если Не ЗначениеЗаполнено(ПараметрыПисьма.УчетнаяЗапись) Тогда
            Результат.ОписаниеОшибки = "Не определена учетная запись электронной почты для отправки.";
            Возврат Результат;
        КонецЕсли;

        ПроверитьТаймаутУчетнойЗаписи(ПараметрыПисьма.УчетнаяЗапись);

        Получатель = ПараметрыПисьма.Получатели.Добавить();
        Получатель.Адрес = СокрЛП(АдресEmail);

        ПараметрыПисьма.Тема = ?(ЗначениеЗаполнено(ТемаПисьма), ТемаПисьма, "Уведомление мониторинга 1С");
        ПараметрыПисьма.Тело = ТекстПисьма;
        ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;

        РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(ПараметрыПисьма);

        Результат.Успех = Истина;
    Исключение
        Результат.Успех = Ложь;
        Результат.ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

        ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.УведомленияEmail",
            УровеньЖурналаРегистрации.Ошибка, , УчетнаяЗаписьПочты, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет настройку таймаута SMTP у выбранной учетной записи почты,
// чтобы исключить зависание отправки дольше срока аренды очереди (300 секунд).
//
Процедура ПроверитьТаймаутУчетнойЗаписи(УчетнаяЗапись)

    Попытка
        МетаданныеУЗ = УчетнаяЗапись.Метаданные();
        Если МетаданныеУЗ.Реквизиты.Найти("Таймаут") = Неопределено Тогда
            Возврат;
        КонецЕсли;

        ТаймаутСек = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "Таймаут");
        // Максимально безопасный таймаут на одну SMTP-команду при аренде 300 сек — не более 45 сек
        Если ТипЗнч(ТаймаутСек) = Тип("Число") И (ТаймаутСек = 0 Или ТаймаутСек > 45) Тогда
            ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.УведомленияEmail",
                УровеньЖурналаРегистрации.Предупреждение, , УчетнаяЗапись,
                СтрШаблон("Учетная запись почты '%1' имеет таймаут SMTP %2 сек. Рекомендуется установить 30–45 сек, чтобы гарантировать завершение отправки в пределах 300-секундной аренды очереди.",
                    Строка(УчетнаяЗапись), Строка(ТаймаутСек)));
        КонецЕсли;
    Исключение
        // Ошибка диагностической проверки не должна блокировать саму отправку письма
    КонецПопытки;

КонецПроцедуры

#КонецОбласти
