#Область ПрограммныйИнтерфейс

// Отправляет текстовое сообщение в чат Telegram от имени указанного бота UBT.
//
// Параметры:
//  Бот            - ОпределяемыйТип.ЕРП_БотTelegram - Ссылка на бота из справочника UBT.
//  ChatID         - Строка - Идентификатор чата или пользователя в Telegram.
//  ТекстСообщения - Строка - Текст уведомления.
//
// Возвращаемое значение:
//  Структура - Содержит поля:
//   * Успех          - Булево - Истина, если API Telegram вернул ok = true.
//   * ОписаниеОшибки - Строка - Описание ошибки от API Telegram или транспортного уровня.
//
Функция ОтправитьСообщение(Бот, ChatID, ТекстСообщения) Экспорт
	
	Результат = Новый Структура("Успех, ОписаниеОшибки", Ложь, "");
	
	Если Не ЗначениеЗаполнено(Бот) Тогда
		Результат.ОписаниеОшибки = "Не указан бот Telegram для отправки.";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ChatID) Тогда
		Результат.ОписаниеОшибки = "Не указан ChatID получателя.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ТокенБота = ПолучитьТокенБотаUBT(Бот);
		Если Не ЗначениеЗаполнено(ТокенБота) Тогда
			Результат.ОписаниеОшибки = "У выбранного бота не заполнен токен API.";
			Возврат Результат;
		КонецЕсли;
		
		// Формирование запроса к Telegram Bot API (совместимо со всеми версиями платформы 8.3.10+)
		Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 15, Новый ЗащищенноеСоединениеOpenSSL());
		
		ТелоЗапросаСтруктура = Новый Структура;
		ТелоЗапросаСтруктура.Вставить("chat_id", СокрЛП(ChatID));
		ТелоЗапросаСтруктура.Вставить("text", ТекстСообщения);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоЗапросаСтруктура);
		ТелоЗапросаJSON = ЗаписьJSON.Закрыть();
		
		HTTPЗапрос = Новый HTTPЗапрос("/bot" + СокрЛП(ТокенБота) + "/sendMessage");
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		РазобратьОтветTelegram(HTTPОтвет.КодСостояния, ТелоОтвета, Результат);
		
	Исключение
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.УведомленияTelegram",
			УровеньЖурналаРегистрации.Ошибка, , Бот, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТокенБотаUBT(Бот)
	
	// В типовых версиях UBT реквизит называется "Токен" или "Token"
	Попытка
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Бот, "Токен");
	Исключение
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Бот, "Token");
	КонецПопытки;
	
КонецФункции

Процедура РазобратьОтветTelegram(КодСостояния, ТелоОтвета, Результат)
	
	Если ПустаяСтрока(ТелоОтвета) Тогда
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = СтрШаблон("Пустой ответ от сервера Telegram (HTTP %1).", КодСостояния);
		Возврат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ОтветСтруктура = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ОтветСтруктура) = Тип("Структура") И ОтветСтруктура.Свойство("ok") Тогда
			Если ОтветСтруктура.ok = Истина И КодСостояния = 200 Тогда
				Результат.Успех = Истина;
			Иначе
				ОписаниеAPI = ?(ОтветСтруктура.Свойство("description"), Строка(ОтветСтруктура.description), "Неизвестная ошибка API");
				КодОшибкиAPI = ?(ОтветСтруктура.Свойство("error_code"), Строка(ОтветСтруктура.error_code), Строка(КодСостояния));
				Результат.Успех = Ложь;
				Результат.ОписаниеОшибки = СтрШаблон("Telegram API [%1]: %2", КодОшибкиAPI, ОписаниеAPI);
			КонецЕсли;
		Иначе
			Результат.Успех = Ложь;
			Результат.ОписаниеОшибки = СтрШаблон("Некорректный формат ответа Telegram (HTTP %1): %2", КодСостояния, Лев(ТелоОтвета, 200));
		КонецЕсли;
	Исключение
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = СтрШаблон("Ошибка разбора JSON ответа Telegram (HTTP %1): %2",
			КодСостояния, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
