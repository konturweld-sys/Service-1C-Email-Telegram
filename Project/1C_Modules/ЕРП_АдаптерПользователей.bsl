#Область ПрограммныйИнтерфейс

// Проверяет, что пользователь не помечен на удаление и не отмечен как недействительный.
//
// Параметры:
//  Пользователь - ОпределяемыйТип.ЕРП_ПолучательУведомлений - Ссылка на пользователя.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь активен.
//
Функция ПользовательАктивен(Пользователь) Экспорт
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеОбъекта = Пользователь.Метаданные();
	ЕстьРеквизитНедействителен = (МетаданныеОбъекта.Реквизиты.Найти("Недействителен") <> Неопределено);
	
	СписокРеквизитов = ?(ЕстьРеквизитНедействителен, "ПометкаУдаления, Недействителен", "ПометкаУдаления");
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Пользователь, СписокРеквизитов);
	
	ПометкаУдаления = Ложь;
	Если ЗначенияРеквизитов.Свойство("ПометкаУдаления", ПометкаУдаления) И ПометкаУдаления = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЕстьРеквизитНедействителен Тогда
		Недействителен = Ложь;
		Если ЗначенияРеквизитов.Свойство("Недействителен", Недействителен) И Недействителен = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Возвращает массив всех заполненных актуальных адресов электронной почты пользователя из БСП.
//
// Параметры:
//  Пользователь - ОпределяемыйТип.ЕРП_ПолучательУведомлений - Ссылка на пользователя.
//
// Возвращаемое значение:
//  Массив из Строка - Список актуальных Email-адресов пользователя.
//
Функция ПолучитьАдресаEmailПользователя(Пользователь) Экспорт
	
	Адреса = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Адреса;
	КонецЕсли;
	
	Попытка
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Пользователь, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		
		УникальныеАдреса = Новый Соответствие;
		Для Каждого СтрокаКИ Из КонтактнаяИнформация Цикл
			АдресЭП = "";
			Если СтрокаКИ.Свойство("АдресЭП", АдресЭП) Тогда
				Адрес = СокрЛП(АдресЭП);
				Если ЗначениеЗаполнено(Адрес) И УникальныеАдреса.Получить(НРег(Адрес)) = Неопределено Тогда
					УникальныеАдреса.Вставить(НРег(Адрес), Истина);
					Адреса.Добавить(Адрес);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.АдаптерПользователей",
			УровеньЖурналаРегистрации.Ошибка, , Пользователь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Адреса;
	
КонецФункции

#КонецОбласти
