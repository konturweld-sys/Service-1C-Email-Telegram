#Область ПрограммныйИнтерфейс

// Возвращает JSON-строку со списком всех активных масок мониторинга для внешней службы .NET.
//
// Возвращаемое значение:
//  Строка - JSON вида {"success": true, "masks": [...]} или {"success": false, "error": "..."}.
//
Функция ПолучитьАктивныеМаскиJSON() Экспорт
	
	Ответ = Новый Структура;
	
	Попытка
		СписокМасок = ЕРП_УправлениеМаскамиМониторинга.ПолучитьСписокАктивныхМасок();
		
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("masks", СписокМасок);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.COM_ПолучениеМасок",
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", ТекстОшибки);
	КонецПопытки;
	
	Возврат СериализоватьВJSON(Ответ);
	
КонецФункции

// Принимает обнаруженное событие от службы .NET и ставит его в очередь отправки уведомлений.
//
// Параметры:
//  ДанныеСобытияJSON - Строка - JSON вида {"maskId": "...", "eventTime": "YYYY-MM-DDTHH:mm:ss", "eventText": "..."}.
//
// Возвращаемое значение:
//  Строка - JSON вида {"success": true} или {"success": false, "error": "..."}.
//
Функция ЗарегистрироватьСобытиеЛога(ДанныеСобытияJSON) Экспорт
	
	Ответ = Новый Структура;
	
	Если ПустаяСтрока(ДанныеСобытияJSON) Тогда
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", "Передана пустая строка JSON.");
		Возврат СериализоватьВJSON(Ответ);
	КонецЕсли;
	
	Попытка
		ДанныеСобытия = ДесериализоватьИзJSON(ДанныеСобытияJSON);
		
		Если ТипЗнч(ДанныеСобытия) <> Тип("Структура") Тогда
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Ожидался JSON-объект (Структура).");
			Возврат СериализоватьВJSON(Ответ);
		КонецЕсли;
		
		// 1. Валидация и поиск маски по GUID
		ИдентификаторМаски = ?(ДанныеСобытия.Свойство("maskId"), Строка(ДанныеСобытия.maskId), "");
		Если ПустаяСтрока(ИдентификаторМаски) Тогда
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Не заполнено обязательное поле maskId.");
			Возврат СериализоватьВJSON(Ответ);
		КонецЕсли;
		
		МаскаСсылка = ЕРП_УправлениеМаскамиМониторинга.НайтиМаскуПоИдентификатору(ИдентификаторМаски);
		Если Не ЗначениеЗаполнено(МаскаСсылка) Тогда
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", СтрШаблон("Маска с идентификатором %1 не найдена в базе 1С.", ИдентификаторМаски));
			Возврат СериализоватьВJSON(Ответ);
		КонецЕсли;
		
		РеквизитыМаски = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МаскаСсылка, "Активна, ПометкаУдаления");
		Если РеквизитыМаски.ПометкаУдаления Или Не РеквизитыМаски.Активна Тогда
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", СтрШаблон("Маска '%1' (%2) не активна или помечена на удаление.",
				Строка(МаскаСсылка), ИдентификаторМаски));
			Возврат СериализоватьВJSON(Ответ);
		КонецЕсли;
		
		// 2. Валидация текста события
		ТекстСобытия = ?(ДанныеСобытия.Свойство("eventText"), Строка(ДанныеСобытия.eventText), "");
		Если ПустаяСтрока(ТекстСобытия) Тогда
			Ответ.Вставить("success", Ложь);
			Ответ.Вставить("error", "Не заполнено обязательное поле eventText.");
			Возврат СериализоватьВJSON(Ответ);
		КонецЕсли;
		
		// 3. Парсинг даты/времени события (ISO 8601)
		ДатаСобытияСтрокой = ?(ДанныеСобытия.Свойство("eventTime"), Строка(ДанныеСобытия.eventTime), "");
		ДатаСобытия = РазобратьДатуISO(ДатаСобытияСтрокой);
		
		// 4. Постановка события в очередь отправки (дедупликация не выполняется по условиям ТЗ)
		ЕРП_ОбработкаОчередиУведомлений.ЗарегистрироватьСобытиеВОчереди(
			МаскаСсылка, ДатаСобытия, ТекстСобытия);
		
		Ответ.Вставить("success", Истина);
		
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.COM_РегистрацияСобытия",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС + "Входной JSON: " + ДанныеСобытияJSON);
		
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("error", ТекстОшибки);
	КонецПопытки;
	
	Возврат СериализоватьВJSON(Ответ);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СериализоватьВJSON(Данные)
	
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ДесериализоватьИзJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
	
КонецФункции

Функция РазобратьДатуISO(ДатаСтрокой)
	
	Если ПустаяСтрока(ДатаСтрокой) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;
	
	Попытка
		// Отбрасываем миллисекунды и часовой пояс при наличии (берем первые 19 символов YYYY-MM-DDTHH:mm:ss)
		ОчищеннаяСтрока = Лев(СокрЛП(ДатаСтрокой), 19);
		Возврат XMLЗначение(Тип("Дата"), ОчищеннаяСтрока);
	Исключение
		Возврат ТекущаяДатаСеанса();
	КонецПопытки;
	
КонецФункции

#КонецОбласти
