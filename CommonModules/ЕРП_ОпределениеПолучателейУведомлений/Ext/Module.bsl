#Область ПрограммныйИнтерфейс

// Вычисляет список уникальных конечных адресатов и каналов отправки по сработавшей маске.
//
Функция СформироватьСписокАдресатовПоМаске(МаскаМониторинга) Экспорт
	
	СписокАдресатов = Новый Массив;
	
	Если Не ЗначениеЗаполнено(МаскаМониторинга) Тогда
		Возврат СписокАдресатов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МаскаМониторинга", МаскаМониторинга);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Группы.ОтправлятьEmail КАК ОтправлятьEmail,
	|	Группы.УчетнаяЗаписьПочты КАК УчетнаяЗаписьПочты,
	|	Группы.ОтправлятьTelegram КАК ОтправлятьTelegram,
	|	Группы.БотTelegram КАК БотTelegram,
	|	Получатели.Пользователь КАК Пользователь,
	|	Получатели.ИспользоватьEmail КАК ИспользоватьEmail,
	|	Получатели.ИспользоватьTelegram КАК ИспользоватьTelegram,
	|	ЕСТЬNULL(ПривязкиTG.ChatID, """") КАК ChatID,
	|	ЕСТЬNULL(ПривязкиTG.Активна, ЛОЖЬ) КАК ПривязкаTGАктивна
	|ИЗ
	|	РегистрСведений.ЕРП_НазначениеСобытийГруппам КАК Назначения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕРП_ГруппыПолучателейУведомлений КАК Группы
	|		ПО Назначения.ГруппаПолучателей = Группы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕРП_ГруппыПолучателейУведомлений.Получатели КАК Получатели
	|		ПО Группы.Ссылка = Получатели.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЕРП_ПривязкиTelegram КАК ПривязкиTG
	|		ПО Получатели.Пользователь = ПривязкиTG.Пользователь
	|			И Группы.БотTelegram = ПривязкиTG.Бот
	|ГДЕ
	|	Назначения.МаскаМониторинга = &МаскаМониторинга
	|	И Назначения.Активно = ИСТИНА
	|	И Группы.Активна = ИСТИНА
	|	И Группы.ПометкаУдаления = ЛОЖЬ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КешАктивностиПользователей = Новый Соответствие;
	КешАдресовEmail = Новый Соответствие;
	УникальныеКлючиОтправки = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Пользователь = Выборка.Пользователь;
		Если Не ЗначениеЗаполнено(Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		
		Активен = КешАктивностиПользователей.Получить(Пользователь);
		Если Активен = Неопределено Тогда
			Активен = ЕРП_АдаптерПользователей.ПользовательАктивен(Пользователь);
			КешАктивностиПользователей.Вставить(Пользователь, Активен);
		КонецЕсли;
		
		Если Не Активен Тогда
			Продолжить;
		КонецЕсли;
		
		// 1. Все актуальные Email пользователя
		Если Выборка.ОтправлятьEmail И Выборка.ИспользоватьEmail Тогда
			МассивEmail = КешАдресовEmail.Получить(Пользователь);
			Если МассивEmail = Неопределено Тогда
				МассивEmail = ЕРП_АдаптерПользователей.ПолучитьАдресаEmailПользователя(Пользователь);
				КешАдресовEmail.Вставить(Пользователь, МассивEmail);
			КонецЕсли;
			
			Для Каждого АдресEmail Из МассивEmail Цикл
				КлючEmail = "Email|" + НРег(АдресEmail) + "|" + Строка(Выборка.УчетнаяЗаписьПочты);
				Если УникальныеКлючиОтправки.Получить(КлючEmail) = Неопределено Тогда
					УникальныеКлючиОтправки.Вставить(КлючEmail, Истина);
					
					Элемент = Новый Структура;
					Элемент.Вставить("КаналОтправки", Перечисления.ЕРП_КаналыУведомлений.Email);
					Элемент.Вставить("АдресПолучателя", АдресEmail);
					Элемент.Вставить("УчетнаяЗаписьПочты", Выборка.УчетнаяЗаписьПочты);
					Элемент.Вставить("БотTelegram", Неопределено);
					СписокАдресатов.Добавить(Элемент);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// 2. Все активные привязки Telegram пользователя для бота группы
		Если Выборка.ОтправлятьTelegram И Выборка.ИспользоватьTelegram
			И Выборка.ПривязкаTGАктивна И ЗначениеЗаполнено(Выборка.ChatID)
			И ЗначениеЗаполнено(Выборка.БотTelegram) Тогда
			
			КлючTG = "TG|" + СокрЛП(Выборка.ChatID) + "|" + Строка(Выборка.БотTelegram);
			Если УникальныеКлючиОтправки.Получить(КлючTG) = Неопределено Тогда
				УникальныеКлючиОтправки.Вставить(КлючTG, Истина);
				
				Элемент = Новый Структура;
				Элемент.Вставить("КаналОтправки", Перечисления.ЕРП_КаналыУведомлений.Telegram);
				Элемент.Вставить("АдресПолучателя", СокрЛП(Выборка.ChatID));
				Элемент.Вставить("УчетнаяЗаписьПочты", Неопределено);
				Элемент.Вставить("БотTelegram", Выборка.БотTelegram);
				СписокАдресатов.Добавить(Элемент);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокАдресатов;
	
КонецФункции

#КонецОбласти
