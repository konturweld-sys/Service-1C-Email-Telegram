#Область ПрограммныйИнтерфейс

// Регистрирует входящее событие в очереди отправки для всех вычисленных адресатов.
Процедура ЗарегистрироватьСобытиеВОчереди(МаскаМониторинга, ДатаСобытияЛога, ТекстУведомления) Экспорт
	
	СписокАдресатов = ЕРП_ОпределениеПолучателейУведомлений.СформироватьСписокАдресатовПоМаске(МаскаМониторинга);
	Если СписокАдресатов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяДатаСервера = ТекущаяДатаСеанса();
	ПустойГУИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	ПустаяДата = Дата(1, 1, 1);
	НаборЗаписей = РегистрыСведений.ЕРП_ОчередьУведомлений.СоздатьНаборЗаписей();
	
	Для Каждого Адресат Из СписокАдресатов Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ИдентификаторЗаписи = Новый УникальныйИдентификатор();
		НоваяЗапись.ДатаРегистрации = ТекущаяДатаСервера;
		НоваяЗапись.ДатаСобытияЛога = ДатаСобытияЛога;
		НоваяЗапись.МаскаМониторинга = МаскаМониторинга;
		НоваяЗапись.ТекстУведомления = ТекстУведомления;
		НоваяЗапись.КаналОтправки = Адресат.КаналОтправки;
		НоваяЗапись.АдресПолучателя = Адресат.АдресПолучателя;
		НоваяЗапись.УчетнаяЗаписьПочты = Адресат.УчетнаяЗаписьПочты;
		НоваяЗапись.БотTelegram = Адресат.БотTelegram;
		НоваяЗапись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.КОтправке;
		НоваяЗапись.КоличествоПопыток = 0;
		НоваяЗапись.ТекстОшибки = "";
		НоваяЗапись.ИдентификаторРезервации = ПустойГУИД;
		НоваяЗапись.ДатаРезервации = ПустаяДата;
		НоваяЗапись.СрокРезервации = ПустаяДата;
		НоваяЗапись.ДатаСледующейПопытки = ТекущаяДатаСервера;
	КонецЦикла;
	
	НаборЗаписей.Записать(Ложь);
	
КонецПроцедуры

// Основная процедура регламентного задания отправки уведомлений.
// Обработка разрешена только при наличии ровно одной записи профиля "Основной".
Процедура ВыполнитьОтправкуОчереди() Экспорт
	
	ПроверкаНастроек = ПолучитьЕдинственныеНастройкиУведомлений();
	Если Не ПроверкаНастроек.Корректны Тогда
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.ОбработкаОчереди",
			УровеньЖурналаРегистрации.Ошибка, , , ПроверкаНастроек.ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Настройки = ПроверкаНастроек.Настройки;
	Если Не Настройки.ОтправкаРазрешена Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяДатаСервера = ТекущаяДатаСеанса();
	
	// Сначала финализируем просроченные аренды с исчерпанным лимитом попыток.
	ЗакрытьПросроченныеЗаписиСИсчерпаннымиПопытками(
		Настройки.МаксимальноеКоличествоПопыток, ТекущаяДатаСервера);
	
	// Затем выбираем записи, доступные для отправки или повторного захвата аренды.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтатусКОтправке", Перечисления.ЕРП_СтатусыОтправкиУведомлений.КОтправке);
	Запрос.УстановитьПараметр("СтатусОбрабатывается", Перечисления.ЕРП_СтатусыОтправкиУведомлений.Обрабатывается);
	Запрос.УстановитьПараметр("МаксПопыток", Настройки.МаксимальноеКоличествоПопыток);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСервера);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	Очередь.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.ЕРП_ОчередьУведомлений КАК Очередь
	|ГДЕ
	|	Очередь.КоличествоПопыток < &МаксПопыток
	|	И Очередь.ДатаСледующейПопытки <= &ТекущаяДата
	|	И (Очередь.Статус = &СтатусКОтправке
	|		ИЛИ (Очередь.Статус = &СтатусОбрабатывается
	|			И Очередь.СрокРезервации < &ТекущаяДата))
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаСледующейПопытки ВОЗР,
	|	Очередь.ДатаРегистрации ВОЗР";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбработатьОднуЗаписьПоАренде(Выборка.ИдентификаторЗаписи, Настройки);
	КонецЦикла;
	
КонецПроцедуры

// Регламентная очистка устаревших записей в финальных статусах.
// За один пакет обрабатывается не более 1000 кандидатов; пакеты повторяются до исчерпания.
Процедура ОчиститьУстаревшиеЗаписиОчереди() Экспорт
	
	ПроверкаНастроек = ПолучитьЕдинственныеНастройкиУведомлений();
	Если Не ПроверкаНастроек.Корректны Тогда
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.ОчисткаОчереди",
			УровеньЖурналаРегистрации.Ошибка, , , ПроверкаНастроек.ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	СрокХраненияДней = ПроверкаНастроек.Настройки.СрокХраненияОчередиДней;
	Если СрокХраненияДней <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ГраницаУдаления = ТекущаяДатаСеанса() - (СрокХраненияДней * 86400);
	
	Пока Истина Цикл
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СтатусОтправлено", Перечисления.ЕРП_СтатусыОтправкиУведомлений.Отправлено);
		Запрос.УстановитьПараметр("СтатусОшибка", Перечисления.ЕРП_СтатусыОтправкиУведомлений.Ошибка);
		Запрос.УстановитьПараметр("ГраницаУдаления", ГраницаУдаления);
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	Очередь.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ЕРП_ОчередьУведомлений КАК Очередь
		|ГДЕ
		|	Очередь.Статус В (&СтатусОтправлено, &СтатусОшибка)
		|	И Очередь.ДатаРегистрации < &ГраницаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ДатаРегистрации";
		
		Выборка = Запрос.Выполнить().Выбрать();
		КоличествоКандидатов = 0;
		КоличествоУдаленных = 0;
		Пока Выборка.Следующий() Цикл
			КоличествоКандидатов = КоличествоКандидатов + 1;
			Если УдалитьЗаписьОчередиБезопасно(Выборка.ИдентификаторЗаписи, ГраницаУдаления) Тогда
				КоличествоУдаленных = КоличествоУдаленных + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если КоличествоКандидатов < 1000 Или КоличествоУдаленных = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет целостность единственного глобального профиля настроек.
Функция ПолучитьЕдинственныеНастройкиУведомлений() Экспорт
	
	Результат = Новый Структура("Корректны, ОписаниеОшибки, Настройки", Ложь, "", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Настройки.ПрофильНастроек КАК ПрофильНастроек,
	|	Настройки.ОтправкаРазрешена КАК ОтправкаРазрешена,
	|	Настройки.МаксимальноеКоличествоПопыток КАК МаксимальноеКоличествоПопыток,
	|	Настройки.СрокАрендыСекунд КАК СрокАрендыСекунд,
	|	Настройки.БазоваяЗадержкаПовтораСекунд КАК БазоваяЗадержкаПовтораСекунд,
	|	Настройки.СрокХраненияОчередиДней КАК СрокХраненияОчередиДней
	|ИЗ
	|	РегистрСведений.ЕРП_НастройкиУведомлений КАК Настройки";
	
	ТаблицаНастроек = Запрос.Выполнить().Выгрузить();
	Если ТаблицаНастроек.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Обработка очереди остановлена: в регистре ЕРП_НастройкиУведомлений отсутствует обязательный профиль 'Основной'.";
		Возврат Результат;
	КонецЕсли;
	
	Если ТаблицаНастроек.Количество() > 1 Тогда
		Результат.ОписаниеОшибки = "Обработка очереди остановлена: в регистре ЕРП_НастройкиУведомлений обнаружено несколько записей. Должен существовать ровно один профиль 'Основной'.";
		Возврат Результат;
	КонецЕсли;
	
	СтрокаНастроек = ТаблицаНастроек[0];
	Если СокрЛП(СтрокаНастроек.ПрофильНастроек) <> "Основной" Тогда
		Результат.ОписаниеОшибки = СтрШаблон(
			"Обработка очереди остановлена: единственный профиль настроек должен называться 'Основной' (обнаружен '%1').",
			СтрокаНастроек.ПрофильНастроек);
		Возврат Результат;
	КонецЕсли;
	
	Если СтрокаНастроек.МаксимальноеКоличествоПопыток <= 0
		Или СтрокаНастроек.СрокАрендыСекунд <= 0
		Или СтрокаНастроек.БазоваяЗадержкаПовтораСекунд <= 0 Тогда
		Результат.ОписаниеОшибки = "Обработка очереди остановлена: в профиле 'Основной' должны быть заполнены положительные значения лимита попыток, срока аренды и задержки повтора.";
		Возврат Результат;
	КонецЕсли;
	
	Если СтрокаНастроек.СрокХраненияОчередиДней < 0 Тогда
		Результат.ОписаниеОшибки = "Обработка очереди остановлена: срок хранения очереди не может быть отрицательным.";
		Возврат Результат;
	КонецЕсли;
	
	Настройки = Новый Структура;
	Настройки.Вставить("ОтправкаРазрешена", СтрокаНастроек.ОтправкаРазрешена);
	Настройки.Вставить("МаксимальноеКоличествоПопыток", СтрокаНастроек.МаксимальноеКоличествоПопыток);
	Настройки.Вставить("СрокАрендыСекунд", СтрокаНастроек.СрокАрендыСекунд);
	Настройки.Вставить("БазоваяЗадержкаПовтораСекунд", СтрокаНастроек.БазоваяЗадержкаПовтораСекунд);
	Настройки.Вставить("СрокХраненияОчередиДней", СтрокаНастроек.СрокХраненияОчередиДней);
	
	Результат.Корректны = Истина;
	Результат.Настройки = Настройки;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Финализирует все просроченные аренды, по которым уже исчерпан лимит попыток.
Процедура ЗакрытьПросроченныеЗаписиСИсчерпаннымиПопытками(МаксимальноеКоличествоПопыток, ТекущаяДатаСервера)
	
	Пока Истина Цикл
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СтатусОбрабатывается", Перечисления.ЕРП_СтатусыОтправкиУведомлений.Обрабатывается);
		Запрос.УстановитьПараметр("МаксПопыток", МаксимальноеКоличествоПопыток);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСервера);
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Очередь.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ЕРП_ОчередьУведомлений КАК Очередь
		|ГДЕ
		|	Очередь.Статус = &СтатусОбрабатывается
		|	И Очередь.СрокРезервации < &ТекущаяДата
		|	И Очередь.КоличествоПопыток >= &МаксПопыток
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.СрокРезервации";
		
		Выборка = Запрос.Выполнить().Выбрать();
		КоличествоКандидатов = 0;
		КоличествоОбработанных = 0;
		Пока Выборка.Следующий() Цикл
			КоличествоКандидатов = КоличествоКандидатов + 1;
			Если ФинализироватьПросроченнуюЗапись(Выборка.ИдентификаторЗаписи, МаксимальноеКоличествоПопыток) Тогда
				КоличествоОбработанных = КоличествоОбработанных + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если КоличествоКандидатов < 100 Или КоличествоОбработанных = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ФинализироватьПросроченнуюЗапись(ИдентификаторЗаписи, МаксимальноеКоличествоПопыток)
	
	Успех = Ложь;
	ПустойГУИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	ПустаяДата = Дата(1, 1, 1);
	
	НачатьТранзакцию();
	Попытка
		УстановитьИсключительнуюБлокировкуЗаписи(ИдентификаторЗаписи);
		НаборЗаписей = РегистрыСведений.ЕРП_ОчередьУведомлений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			Запись = НаборЗаписей[0];
			Если Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Обрабатывается
				И Запись.СрокРезервации < ТекущаяДатаСеанса()
				И Запись.КоличествоПопыток >= МаксимальноеКоличествоПопыток Тогда
				
				Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Ошибка;
				Запись.ИдентификаторРезервации = ПустойГУИД;
				Запись.ДатаРезервации = ПустаяДата;
				Запись.СрокРезервации = ПустаяДата;
				Запись.ТекстОшибки = "Превышен срок аренды при исчерпанном лимите попыток";
				НаборЗаписей.Записать(Истина);
				Успех = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.ФинализацияПросроченных",
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Успех;
	
КонецФункции

Функция УдалитьЗаписьОчередиБезопасно(ИдентификаторЗаписи, ГраницаУдаления)
	
	Успех = Ложь;
	НачатьТранзакцию();
	Попытка
		УстановитьИсключительнуюБлокировкуЗаписи(ИдентификаторЗаписи);
		НаборЗаписей = РегистрыСведений.ЕРП_ОчередьУведомлений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			Запись = НаборЗаписей[0];
			Если (Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Отправлено
				Или Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Ошибка)
				И Запись.ДатаРегистрации < ГраницаУдаления Тогда
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать(Истина);
				Успех = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.ОчисткаОчереди",
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Успех;
	
КонецФункции

Процедура ОбработатьОднуЗаписьПоАренде(ИдентификаторЗаписи, Настройки)
	
	Захват = ЗарезервироватьЗапись(
		ИдентификаторЗаписи,
		Настройки.МаксимальноеКоличествоПопыток,
		Настройки.СрокАрендыСекунд);
	Если Не Захват.Успех Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		РезультатОтправки = ВыполнитьОтправкуЧерезАдаптер(Захват.ДанныеЗаписи);
	Исключение
		РезультатОтправки = Новый Структура("Успех, ОписаниеОшибки, RetryAfter",
			Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), 0);
	КонецПопытки;
	
	ЗафиксироватьРезультатОтправки(
		ИдентификаторЗаписи,
		Захват.ИдентификаторВладельца,
		Захват.НомерТекущейПопытки,
		Настройки,
		РезультатОтправки);
	
КонецПроцедуры

Функция ЗарезервироватьЗапись(ИдентификаторЗаписи, МаксимальноеКоличествоПопыток, СрокАрендыСекунд)
	
	Результат = Новый Структура("Успех, ИдентификаторВладельца, НомерТекущейПопытки, ДанныеЗаписи",
		Ложь, Неопределено, 0, Неопределено);
	
	НачатьТранзакцию();
	Попытка
		УстановитьИсключительнуюБлокировкуЗаписи(ИдентификаторЗаписи);
		НаборЗаписей = РегистрыСведений.ЕРП_ОчередьУведомлений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;
		
		Запись = НаборЗаписей[0];
		ТекущаяДата = ТекущаяДатаСеанса();
		ЗаписьСвободна = Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.КОтправке;
		АрендаПросрочена = Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Обрабатывается
			И Запись.СрокРезервации < ТекущаяДата;
		
		Если (Не ЗаписьСвободна И Не АрендаПросрочена)
			Или Запись.КоличествоПопыток >= МаксимальноеКоличествоПопыток
			Или Запись.ДатаСледующейПопытки > ТекущаяДата Тогда
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;
		
		ИдентификаторВладельца = Новый УникальныйИдентификатор();
		НомерПопытки = Запись.КоличествоПопыток + 1;
		Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Обрабатывается;
		Запись.ИдентификаторРезервации = ИдентификаторВладельца;
		Запись.ДатаРезервации = ТекущаяДата;
		Запись.СрокРезервации = ТекущаяДата + СрокАрендыСекунд;
		Запись.КоличествоПопыток = НомерПопытки;
		
		ДанныеЗаписи = Новый Структура;
		ДанныеЗаписи.Вставить("КаналОтправки", Запись.КаналОтправки);
		ДанныеЗаписи.Вставить("АдресПолучателя", Запись.АдресПолучателя);
		ДанныеЗаписи.Вставить("ТекстУведомления", Запись.ТекстУведомления);
		ДанныеЗаписи.Вставить("УчетнаяЗаписьПочты", Запись.УчетнаяЗаписьПочты);
		ДанныеЗаписи.Вставить("БотTelegram", Запись.БотTelegram);
		ДанныеЗаписи.Вставить("НаименованиеМаски", Строка(Запись.МаскаМониторинга));
		
		НаборЗаписей.Записать(Истина);
		ЗафиксироватьТранзакцию();
		Результат.Успех = Истина;
		Результат.ИдентификаторВладельца = ИдентификаторВладельца;
		Результат.НомерТекущейПопытки = НомерПопытки;
		Результат.ДанныеЗаписи = ДанныеЗаписи;
		
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.РезервированиеОчереди",
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьОтправкуЧерезАдаптер(ДанныеЗаписи)
	
	Если ДанныеЗаписи.КаналОтправки = Перечисления.ЕРП_КаналыУведомлений.Email Тогда
		ТемаПисьма = СтрШаблон("Мониторинг логов 1С: %1", ДанныеЗаписи.НаименованиеМаски);
		Возврат ЕРП_УведомленияEmail.ОтправитьПисьмо(
			ДанныеЗаписи.АдресПолучателя,
			ТемаПисьма,
			ДанныеЗаписи.ТекстУведомления,
			ДанныеЗаписи.УчетнаяЗаписьПочты);
	ИначеЕсли ДанныеЗаписи.КаналОтправки = Перечисления.ЕРП_КаналыУведомлений.Telegram Тогда
		Возврат ЕРП_УведомленияTelegram.ОтправитьСообщение(
			ДанныеЗаписи.БотTelegram,
			ДанныеЗаписи.АдресПолучателя,
			ДанныеЗаписи.ТекстУведомления);
	Иначе
		Возврат Новый Структура("Успех, ОписаниеОшибки, RetryAfter",
			Ложь, "Неизвестный канал отправки.", 0);
	КонецЕсли;
	
КонецФункции

Процедура ЗафиксироватьРезультатОтправки(
	ИдентификаторЗаписи,
	ИдентификаторВладельца,
	НомерТекущейПопытки,
	Настройки,
	РезультатОтправки)
	
	ПустойГУИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	ПустаяДата = Дата(1, 1, 1);
	
	НачатьТранзакцию();
	Попытка
		УстановитьИсключительнуюБлокировкуЗаписи(ИдентификаторЗаписи);
		НаборЗаписей = РегистрыСведений.ЕРП_ОчередьУведомлений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Запись = НаборЗаписей[0];
		Если Запись.Статус <> Перечисления.ЕРП_СтатусыОтправкиУведомлений.Обрабатывается
			Или Запись.ИдентификаторРезервации <> ИдентификаторВладельца Тогда
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.ФиксацияОчереди",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("Попытка фиксации результата устаревшим обработчиком (UUID владельца %1 не совпадает с %2).",
					Строка(ИдентификаторВладельца), Строка(Запись.ИдентификаторРезервации)));
			Возврат;
		КонецЕсли;
		
		ТекущаяДата = ТекущаяДатаСеанса();
		Запись.ИдентификаторРезервации = ПустойГУИД;
		Запись.ДатаРезервации = ПустаяДата;
		Запись.СрокРезервации = ПустаяДата;
		
		Если РезультатОтправки.Успех Тогда
			Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Отправлено;
			Запись.ТекстОшибки = "";
		Иначе
			Запись.ТекстОшибки = Лев(РезультатОтправки.ОписаниеОшибки, 1000);
			Если НомерТекущейПопытки >= Настройки.МаксимальноеКоличествоПопыток Тогда
				Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.Ошибка;
			Иначе
				Запись.Статус = Перечисления.ЕРП_СтатусыОтправкиУведомлений.КОтправке;
				ЗадержкаСекунд = ВычислитьЗадержкуПовтора(
					НомерТекущейПопытки, Настройки.БазоваяЗадержкаПовтораСекунд, РезультатОтправки);
				Запись.ДатаСледующейПопытки = ТекущаяДата + ЗадержкаСекунд;
			КонецЕсли;
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
		ЗафиксироватьТранзакцию();
		
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ЕРП_МониторингЛогов.ФиксацияОчереди",
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьИсключительнуюБлокировкуЗаписи(ИдентификаторЗаписи)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЕРП_ОчередьУведомлений");
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗаписи", ИдентификаторЗаписи);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция ВычислитьЗадержкуПовтора(НомерПопытки, БазоваяЗадержкаСекунд, РезультатОтправки)
	
	ЗначениеRetryAfter = 0;
	Если РезультатОтправки.Свойство("RetryAfter", ЗначениеRetryAfter)
		И ТипЗнч(ЗначениеRetryAfter) = Тип("Число")
		И ЗначениеRetryAfter > 0 Тогда
		Возврат ЗначениеRetryAfter;
	КонецЕсли;
	
	Возврат БазоваяЗадержкаСекунд * НомерПопытки;
	
КонецФункции

#КонецОбласти
