#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	// Настройки допускают только полную замену единственной записи.
	Если Не Замещение Тогда
		Отказ = Истина;
		ВызватьИсключение "Запись в регистр ЕРП_НастройкиУведомлений разрешена только с замещением единственного профиля 'Основной'.";
	КонецЕсли;
	
	Если Количество() <> 1 Тогда
		Отказ = Истина;
		ВызватьИсключение "В наборе записи настроек должна находиться ровно одна запись профиля 'Основной'.";
	КонецЕсли;
	
	ЗаписьНастроек = ЭтотОбъект[0];
	Если СокрЛП(ЗаписьНастроек.ПрофильНастроек) <> "Основной" Тогда
		Отказ = Истина;
		ВызватьИсключение "Допускается только профиль настроек с ключом 'Основной'.";
	КонецЕсли;
	
	ЭлементОтбора = Отбор.ПрофильНастроек;
	Если ЭлементОтбора.Использование
		И СокрЛП(ЭлементОтбора.Значение) <> "Основной" Тогда
		Отказ = Истина;
		ВызватьИсключение "Отбор при записи настроек должен соответствовать профилю 'Основной'.";
	КонецЕсли;
	
	// Проверяем весь регистр, а не только записи, попавшие в текущий отбор набора.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.ПрофильНастроек КАК ПрофильНастроек
	|ИЗ
	|	РегистрСведений.ЕРП_НастройкиУведомлений КАК Настройки
	|ГДЕ
	|	Настройки.ПрофильНастроек <> &ОсновнойПрофиль";
	Запрос.УстановитьПараметр("ОсновнойПрофиль", "Основной");
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		ВызватьИсключение "В регистре ЕРП_НастройкиУведомлений обнаружены посторонние профили. Запись заблокирована; сначала восстановите целостность регистра.";
	КонецЕсли;
	
	Если ЗаписьНастроек.МаксимальноеКоличествоПопыток < 1
		Или ЗаписьНастроек.СрокАрендыСекунд < 60
		Или ЗаписьНастроек.БазоваяЗадержкаПовтораСекунд < 5
		Или ЗаписьНастроек.СрокХраненияОчередиДней < 1 Тогда
		Отказ = Истина;
		ВызватьИсключение "Некорректные числовые параметры профиля 'Основной' (попытки >= 1, аренда >= 60 сек, задержка >= 5 сек, хранение >= 1 дн).";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
