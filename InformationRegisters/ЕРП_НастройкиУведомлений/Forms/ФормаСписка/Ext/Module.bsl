#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ПроверитьИИнициализироватьПрофильНаСервере() Тогда
		Элементы.Список.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	ПоказатьПредупреждение(, "Создание дополнительных профилей запрещено. В системе используется только единственный профиль 'Основной'.");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	ПоказатьПредупреждение(, "Удаление единственного профиля настроек 'Основной' запрещено.");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьИИнициализироватьПрофильНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Настройки.ПрофильНастроек КАК ПрофильНастроек
	|ИЗ
	|	РегистрСведений.ЕРП_НастройкиУведомлений КАК Настройки";
	
	ТаблицаНастроек = Запрос.Выполнить().Выгрузить();
	
	// Создание профиля допускается только при полностью пустом регистре.
	Если ТаблицаНастроек.Количество() = 0 Тогда
		НаборЗаписей = РегистрыСведений.ЕРП_НастройкиУведомлений.СоздатьНаборЗаписей();
		ЗаписьНастроек = НаборЗаписей.Добавить();
		ЗаписьНастроек.ПрофильНастроек = "Основной";
		ЗаписьНастроек.ОтправкаРазрешена = Истина;
		ЗаписьНастроек.МаксимальноеКоличествоПопыток = 3;
		ЗаписьНастроек.СрокАрендыСекунд = 300;
		ЗаписьНастроек.БазоваяЗадержкаПовтораСекунд = 30;
		ЗаписьНастроек.СрокХраненияОчередиДней = 30;
		
		Попытка
			НаборЗаписей.Записать(Истина);
			Возврат Истина;
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось создать профиль настроек 'Основной'. Запись регистра не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Если ТаблицаНастроек.Количество() > 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "НАРУШЕНИЕ ЦЕЛОСТНОСТИ: в регистре обнаружено несколько записей. Настройки не изменены; таблица открыта только для просмотра. Обработка очереди остановлена.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	ЕдинственнаяЗапись = ТаблицаНастроек[0];
	Если СокрЛП(ЕдинственнаяЗапись.ПрофильНастроек) <> "Основной" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			"НАРУШЕНИЕ ЦЕЛОСТНОСТИ: обнаружен профиль '%1' вместо 'Основной'. Данные не изменены; таблица открыта только для просмотра. Обработка очереди остановлена.",
			ЕдинственнаяЗапись.ПрофильНастроек);
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
