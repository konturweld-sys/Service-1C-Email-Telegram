#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборТолькоАктивные = Истина;
	ПрименитьОтборыСписка();
	НастроитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборПользовательПриИзменении(Элемент)
	
	ПрименитьОтборыСпискаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборБотПриИзменении(Элемент)
	
	ПрименитьОтборыСпискаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборТолькоАктивныеПриИзменении(Элемент)
	
	ПрименитьОтборыСпискаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ТекущиеДанные.Активна = Истина;
			ТекущиеДанные.Подтверждена = Ложь;
			ТекущиеДанные.КодПодтверждения = "";
			ТекущиеДанные.КодДействителенДо = Дата(1, 1, 1);
			ТекущиеДанные.ПопыткиПодтверждения = 0;
			Если ЗначениеЗаполнено(ОтборПользователь) Тогда
				ТекущиеДанные.Пользователь = ОтборПользователь;
			КонецЕсли;
			Если ЗначениеЗаполнено(ОтборБот) Тогда
				ТекущиеДанные.Бот = ОтборБот;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокChatIDПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчищенныйID = СокрЛП(ТекущиеДанные.ChatID);
	ТекущиеДанные.ChatID = ОчищенныйID;
	
	// При изменении ChatID полностью аннулируем ранее выданный код.
	ТекущиеДанные.Подтверждена = Ложь;
	ТекущиеДанные.КодПодтверждения = "";
	ТекущиеДанные.КодДействителенДо = Дата(1, 1, 1);
	ТекущиеДанные.ПопыткиПодтверждения = 0;
	ТекущиеДанные.ДатаПодтверждения = Дата(1, 1, 1);
	
	Если Не ПустаяСтрока(ОчищенныйID) И Не ПроверитьФорматChatID(ОчищенныйID) Тогда
		ПоказатьПредупреждение(,
			"Некорректный формат Chat ID. Допускаются только цифры и необязательный знак '-' в начале (для групповых чатов).");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСвязьTelegram(Команда)
	
	ТекущиеДанные = ПолучитьЗафиксированнуюТекущуюСтроку();
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ВыполнитьПроверкуСвязиНаСервере(
		ТекущиеДанные.Пользователь, ТекущиеДанные.Бот, СокрЛП(ТекущиеДанные.ChatID));
	
	Если РезультатПроверки.Успех Тогда
		ПоказатьОповещениеПользователя(
			"Telegram: связь подтверждена",
			,
			СтрШаблон("Тестовое сообщение успешно доставлено в чат %1.", СокрЛП(ТекущиеДанные.ChatID)),
			БиблиотекаКартинок.Успешно);
	Иначе
		ПоказатьПредупреждение(,
			СтрШаблон("Не удалось отправить тестовое сообщение в Telegram.%1%1Причина: %2",
				Символы.ПС, РезультатПроверки.ОписаниеОшибки));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКодПодтверждения(Команда)
	
	ТекущиеДанные = ПолучитьЗафиксированнуюТекущуюСтроку();
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ОтправитьКодПодтвержденияНаСервере(
		ТекущиеДанные.Пользователь, ТекущиеДанные.Бот, СокрЛП(ТекущиеДанные.ChatID));
		
	Элементы.Список.Обновить();
	
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			"Код подтверждения отправлен",
			,
			СтрШаблон("Одноразовый код отправлен в чат %1. Введите его по кнопке «Подтвердить привязку».",
				СокрЛП(ТекущиеДанные.ChatID)));
	Иначе
		ПоказатьПредупреждение(,
			СтрШаблон("Не удалось отправить код подтверждения.%1%1Причина: %2",
				Символы.ПС, Результат.ОписаниеОшибки));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьПривязку(Команда)
	
	ТекущиеДанные = ПолучитьЗафиксированнуюТекущуюСтроку();
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("Пользователь, Бот, ChatID",
		ТекущиеДанные.Пользователь, ТекущиеДанные.Бот, СокрЛП(ТекущиеДанные.ChatID));
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗавершитьПодтверждениеПривязки", ЭтотОбъект, ДополнительныеПараметры);
		
	ПоказатьВводСтроки(ОписаниеОповещения, "", "Введите 6-значный код подтверждения из Telegram:", 20);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПодтверждениеПривязки(ВведенныйКод, ДополнительныеПараметры) Экспорт
	
	Если ВведенныйКод = Неопределено Или ПустаяСтрока(СокрЛП(ВведенныйКод)) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПодтвердитьПривязкуПоКодуНаСервере(
		ДополнительныеПараметры.Пользователь,
		ДополнительныеПараметры.Бот,
		ДополнительныеПараметры.ChatID,
		СокрЛП(ВведенныйКод));
		
	Элементы.Список.Обновить();
	
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			"Привязка подтверждена",
			,
			"Принадлежность чата подтверждена. Рассылка уведомлений в этот чат разрешена.",
			БиблиотекаКартинок.Успешно);
	Иначе
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьЗафиксированнуюТекущуюСтроку()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку с привязкой Telegram в списке.");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Элементы.Список.РедактируетсяСтрока() Тогда
		Элементы.Список.ЗакончитьРедактированиеСтроки(Ложь);
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Пользователь) Тогда
		ПоказатьПредупреждение(, "В выбранной строке не указан пользователь.");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Бот) Тогда
		ПоказатьПредупреждение(, "В выбранной строке не указан бот Telegram.");
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПустаяСтрока(СокрЛП(ТекущиеДанные.ChatID)) Тогда
		ПоказатьПредупреждение(, "В выбранной строке не указан Chat ID.");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТекущиеДанные;
	
КонецФункции

&НаСервере
Процедура ПрименитьОтборыСпискаНаСервере()
	
	ПрименитьОтборыСписка();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборыСписка()
	
	Список.Отбор.Элементы.Очистить();
	
	Если ЗначениеЗаполнено(ОтборПользователь) Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Пользователь");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ОтборПользователь;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборБот) Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Бот");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ОтборБот;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
	Если ОтборТолькоАктивные Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Активна");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Истина;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()
	
	// 1. Неактивные привязки — серый текст
	ЭлементНеактивные = УсловноеОформление.Элементы.Добавить();
	ПолеНеактивные = ЭлементНеактивные.Поля.Элементы.Добавить();
	ПолеНеактивные.Поле = Новый ПолеКомпоновкиДанных("Список");
	
	ОтборНеактивные = ЭлементНеактивные.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНеактивные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Активна");
	ОтборНеактивные.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборНеактивные.ПравоеЗначение = Ложь;
	ОтборНеактивные.Использование = Истина;
	
	ЭлементНеактивные.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	
	// 2. Активные, но неподтверждённые привязки — выделение колонки статуса подтверждения
	ЭлементНеподтв = УсловноеОформление.Элементы.Добавить();
	ПолеНеподтв = ЭлементНеподтв.Поля.Элементы.Добавить();
	ПолеНеподтв.Поле = Новый ПолеКомпоновкиДанных("СписокПодтверждена");
	
	ОтборНеподтв = ЭлементНеподтв.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНеподтв.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Подтверждена");
	ОтборНеподтв.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборНеподтв.ПравоеЗначение = Ложь;
	ОтборНеподтв.Использование = Истина;
	
	ЭлементНеподтв.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ОранжевоКрасный);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьФорматChatID(ЗначениеID)
	
	Длина = СтрДлина(ЗначениеID);
	Если Длина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачальныйИндекс = ?(Лев(ЗначениеID, 1) = "-", 2, 1);
	Если НачальныйИндекс > Длина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДопустимыеСимволы = "0123456789";
	Для Индекс = НачальныйИндекс По Длина Цикл
		Символ = Сред(ЗначениеID, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ВыполнитьПроверкуСвязиНаСервере(Пользователь, Бот, ChatID)
	
	ТекстСообщения = СтрШаблон(
		"Проверка связи от 1С:Предприятие.%1Получатель: %2%1Время: %3",
		Символы.ПС,
		Строка(Пользователь),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
		
	Возврат ЕРП_УведомленияTelegram.ОтправитьСообщение(Бот, ChatID, ТекстСообщения);
	
КонецФункции

&НаСервере
Функция ОтправитьКодПодтвержденияНаСервере(Пользователь, Бот, ChatID)
	
	Результат = Новый Структура("Успех, ОписаниеОшибки", Ложь, "");
	ChatID = СокрЛП(ChatID);
	
	Если Не ЗначениеЗаполнено(Пользователь) Или Не ЗначениеЗаполнено(Бот) Тогда
		Результат.ОписаниеОшибки = "Не указан пользователь или бот Telegram.";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ПроверитьФорматChatIDНаСервере(ChatID) Тогда
		Результат.ОписаниеОшибки = "Некорректный формат Chat ID.";
		Возврат Результат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Отбор.Бот.Установить(Бот);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Запись привязки не найдена в регистре.";
		Возврат Результат;
	КонецЕсли;
	
	Если НаборЗаписей.Количество() <> 1 Тогда
		Результат.ОписаниеОшибки = "Найдено несколько записей привязки для пользователя и бота. Уточните ключи регистра.";
		Возврат Результат;
	КонецЕсли;
	
	Запись = НаборЗаписей[0];
	Если Не Запись.Активна Тогда
		Результат.ОписаниеОшибки = "Нельзя подтвердить неактивную привязку.";
		Возврат Результат;
	КонецЕсли;
	
	Если СокрЛП(Запись.ChatID) <> ChatID Тогда
		Результат.ОписаниеОшибки = "Chat ID в выбранной строке не совпадает с сохранённой записью регистра.";
		Возврат Результат;
	КонецЕсли;
	
	ГСЧ = Новый ГенераторСлучайныхЧисел;
	Код = Формат(ГСЧ.СлучайноеЧисло(100000, 999999), "ЧЦ=6; ЧВН=; ЧГ=0");
	
	// Сначала сохраняем код и сбрасываем предыдущее подтверждение.
	Запись.Подтверждена = Ложь;
	Запись.КодПодтверждения = Код;
	Запись.ДатаПодтверждения = Дата(1, 1, 1);
	Запись.КодДействителенДо = ТекущаяДатаСеанса() + 600; // 10 минут
	Запись.ПопыткиПодтверждения = 0;
	НаборЗаписей.Записать(Истина);
	
	ТекстСообщения = СтрШаблон(
		"Код подтверждения привязки уведомлений 1С: %1%2Сообщите этот код администратору для активации рассылки.",
		Код, Символы.ПС);
	
	Попытка
		РезультатОтправки = ЕРП_УведомленияTelegram.ОтправитьСообщение(Бот, ChatID, ТекстСообщения);
	Исключение
		РезультатОтправки = Новый Структура("Успех, ОписаниеОшибки",
			Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если Не РезультатОтправки.Успех Тогда
		// Удаляем только тот код, который сформирован этим вызовом.
		НаборЗаписейОчистки = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьНаборЗаписей();
		НаборЗаписейОчистки.Отбор.Пользователь.Установить(Пользователь);
		НаборЗаписейОчистки.Отбор.Бот.Установить(Бот);
		НаборЗаписейОчистки.Прочитать();
		
		Если НаборЗаписейОчистки.Количество() = 1 Тогда
			ЗаписьОчистки = НаборЗаписейОчистки[0];
			Если ЗаписьОчистки.КодПодтверждения = Код Тогда
				ЗаписьОчистки.КодПодтверждения = "";
				ЗаписьОчистки.КодДействителенДо = Дата(1, 1, 1);
				ЗаписьОчистки.ПопыткиПодтверждения = 0;
				НаборЗаписейОчистки.Записать(Истина);
			КонецЕсли;
		КонецЕсли;
		
		Возврат РезультатОтправки;
	КонецЕсли;
	
	Возврат Новый Структура("Успех, ОписаниеОшибки", Истина, "");
	
КонецФункции

&НаСервере
Функция ПодтвердитьПривязкуПоКодуНаСервере(Пользователь, Бот, ChatID, ВведенныйКод)
	
	Результат = Новый Структура("Успех, ОписаниеОшибки", Ложь, "");
	ChatID = СокрЛП(ChatID);
	ВведенныйКод = СокрЛП(ВведенныйКод);
	
	Если СтрДлина(ВведенныйКод) <> 6 Или Не ПроверитьФорматШестизначногоКода(ВведенныйКод) Тогда
		Результат.ОписаниеОшибки = "Код должен содержать ровно шесть цифр.";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ПроверитьФорматChatID(ChatID) Тогда
		Результат.ОписаниеОшибки = "Некорректный формат Chat ID.";
		Возврат Результат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Отбор.Бот.Установить(Бот);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Запись привязки не найдена.";
		Возврат Результат;
	КонецЕсли;
	
	Если НаборЗаписей.Количество() <> 1 Тогда
		Результат.ОписаниеОшибки = "Найдено несколько записей привязки для пользователя и бота. Подтверждение невозможно.";
		Возврат Результат;
	КонецЕсли;
	
	Запись = НаборЗаписей[0];
	
	Если Не Запись.Активна Тогда
		Результат.ОписаниеОшибки = "Нельзя подтвердить неактивную привязку.";
		Возврат Результат;
	КонецЕсли;
	
	Если СокрЛП(Запись.ChatID) <> ChatID Тогда
		Результат.ОписаниеОшибки = "Chat ID изменился после отправки кода. Запросите новый код.";
		Возврат Результат;
	КонецЕсли;
	
	Если ПустаяСтрока(СокрЛП(Запись.КодПодтверждения)) Тогда
		Результат.ОписаниеОшибки = "Код подтверждения не сформирован или уже использован. Сначала отправьте новый код.";
		Возврат Результат;
	КонецЕсли;
	
	Если Запись.КодДействителенДо = Дата(1, 1, 1)
		Или Запись.КодДействителенДо < ТекущаяДатаСеанса() Тогда
		Запись.КодПодтверждения = "";
		Запись.КодДействителенДо = Дата(1, 1, 1);
		Запись.ПопыткиПодтверждения = 0;
		НаборЗаписей.Записать(Истина);
		Результат.ОписаниеОшибки = "Срок действия кода истёк. Запросите новый код.";
		Возврат Результат;
	КонецЕсли;
	
	Если Запись.ПопыткиПодтверждения >= 5 Тогда
		Результат.ОписаниеОшибки = "Превышено максимальное число попыток. Запросите новый код.";
		Возврат Результат;
	КонецЕсли;
	
	Если Запись.КодПодтверждения <> ВведенныйКод Тогда
		Запись.ПопыткиПодтверждения = Запись.ПопыткиПодтверждения + 1;
		Если Запись.ПопыткиПодтверждения >= 5 Тогда
			Запись.КодПодтверждения = "";
			Запись.КодДействителенДо = Дата(1, 1, 1);
		КонецЕсли;
		НаборЗаписей.Записать(Истина);
		Если Запись.ПопыткиПодтверждения >= 5 Тогда
			Результат.ОписаниеОшибки = "Превышено максимальное число попыток. Запросите новый код.";
		Иначе
			Результат.ОписаниеОшибки = "Введён неверный код подтверждения.";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Запись.Подтверждена = Истина;
	Запись.КодПодтверждения = "";
	Запись.КодДействителенДо = Дата(1, 1, 1);
	Запись.ПопыткиПодтверждения = 0;
	Запись.ДатаПодтверждения = ТекущаяДатаСеанса();
	НаборЗаписей.Записать(Истина);
	
	Возврат Новый Структура("Успех, ОписаниеОшибки", Истина, "");
	
КонецФункции

&НаСервере
Функция ПроверитьФорматChatIDНаСервере(ЗначениеID)
	
	Длина = СтрДлина(ЗначениеID);
	Если Длина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачальныйИндекс = ?(Лев(ЗначениеID, 1) = "-", 2, 1);
	Если НачальныйИндекс > Длина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = НачальныйИндекс По Длина Цикл
		Если СтрНайти("0123456789", Сред(ЗначениеID, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверитьФорматШестизначногоКода(ЗначениеКода)
	
	Если СтрДлина(ЗначениеКода) <> 6 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По 6 Цикл
		Если СтрНайти("0123456789", Сред(ЗначениеКода, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
